# My Secret Credentials are written over here

# Database URL
DATABASE_URL=postgresql+psycopg://user:password@localhost:5433/docuquery

# Embedding provider: auto, gemini, or jina
EMBEDDING_PROVIDER=auto
EMBEDDING_CACHE_PATH=.cache/embedding_cache.sqlite3

# Privacy mode: on uses Ollama for generation and Jina for embeddings
PRIVACY_MODE=off

# Gemini embedding & generation models
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GOOGLE_GENERATION_MODEL=gemini-3-flash-preview 

# Gemini API key for embeddings and generation
GOOGLE_API_KEY=YOUR_GOOGLE_AI_STUDIO_KEY

# Jina embedding models
JINA_EMBEDDING_MODEL=jina-embeddings-v3

# Jina API key for embedding fallback
JINA_API_KEY=YOUR_JINA_API_KEY

# Existing Ollama/OpenAI-compatible endpoint
LLM_URL=YOUR_LLM_PROVIDER_URL

# Model available from your configured provider
LLM_MODEL=YOUR_LLM_MODEL

# Ollama accepts a placeholder value; use your real key for hosted providers
LLM_API_KEY=YOUR_LLM_API_KEY

# Password reset email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=user@yourdomain.com
SMTP_USE_TLS=true
FRONTEND_BASE_URL=http://127.0.0.1:8000

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
SESSION_SECRET=replace-with-a-random-session-secret
