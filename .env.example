# My Secret Credentials are written over here

# Database URL
DATABASE_URL=postgresql+psycopg://user:password@localhost:5433/docuquery

EMBEDDING_CACHE_PATH=.cache/embedding_cache.sqlite3

# Local OpenAI-compatible model server (Ollama, LM Studio, etc.)
LLM_PROVIDER=local
LLM_URL=http://localhost:11434
LLM_MODEL=YOUR_LOCAL_CHAT_MODEL
# Optional for local servers; never send this value from the browser.
LLM_API_KEY=

# Choose one embedding backend. Credentials and model configuration stay in .env.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=YOUR_LOCAL_EMBEDDING_MODEL
# Set EMBEDDING_PROVIDER=jina to use the optional third-party backend below.
JINA_EMBEDDING_MODEL=jina-embeddings-v3
JINA_EMBEDDING_URL=https://api.jina.ai/v1/embeddings
JINA_API_KEY=

# Password reset email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=user@yourdomain.com
SMTP_USE_TLS=true
FRONTEND_BASE_URL=http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
SESSION_SECRET=replace-with-a-random-session-secret
